# Plantilla de configuración de ByteTrack (principio VI de la constitución).
# Copie este archivo a `.env` (ignorado por git) —o a otra ruta apuntada con BYTETRACK_ENV_FILE—
# y complete los valores. NO escriba valores reales en este archivo ni lo suba al repositorio.

# --- Obligatorias (sin valor por defecto) ---
# Clave de firma de los tokens: mínimo 32 caracteres.
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BYTETRACK_JWT_SECRET=
# Contraseña del usuario Recepcionista (la usa `uv run python -m app.seed`).
BYTETRACK_RECEPCIONISTA_CLAVE=
# Contraseña del usuario Técnico (la usa `uv run python -m app.seed`).
BYTETRACK_TECNICO_CLAVE=

# --- Opcionales (valores por defecto no secretos) ---
# BYTETRACK_RECEPCIONISTA_USUARIO=recepcion
# BYTETRACK_TECNICO_USUARIO=tecnico
# Duración de la sesión en minutos.
# BYTETRACK_SESION_MINUTOS=60
# Ruta del archivo de entorno (por defecto ./.env).
# BYTETRACK_ENV_FILE=./.env
# BYTETRACK_DB_PATH=./bytetrack.db
# BYTETRACK_COSTO_REVISION=40.00
